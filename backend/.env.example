# Application
APP_NAME=SmartInvest Analyzer
APP_VERSION=1.0.0
DEBUG=True
ENVIRONMENT=development

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://smartinvest:password@localhost:5432/smartinvest_db
# For Docker: postgresql://smartinvest:password@postgres:5432/smartinvest_db

# Redis
REDIS_URL=redis://localhost:6379/0
# For Docker: redis://redis:6379/0

# API Keys
ALPHA_VANTAGE_API_KEY=your_alpha_vantage_key_here
NEWS_API_KEY=your_news_api_key_here
FINNHUB_API_KEY=your_finnhub_key_here

# CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60

# Cache TTL (in seconds)
CACHE_TTL_QUOTE=60
CACHE_TTL_HISTORICAL=300
CACHE_TTL_TECHNICALS=300
CACHE_TTL_FUNDAMENTALS=3600
CACHE_TTL_NEWS=600
